# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_DB=resilientlab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=Host=postgres;Port=5432;Database=resilientlab;Username=postgres;Password=postgres

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_DB_URL=postgresql://postgres:postgres@postgres:5432/resilientlab
MOCK_API_URL=http://mock-api:8090
WORKER_CONCURRENCY=5
WORKER_BATCH_SIZE=20
WORKER_POLL_INTERVAL_MS=5000
WORKER_RETRY_MAX=3
WORKER_RETRY_BASE_DELAY_MS=500

# ─── API (control plane) ─────────────────────────────────────────────────────
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# ─── Mock API ─────────────────────────────────────────────────────────────────
MOCK_API_PORT=8090
